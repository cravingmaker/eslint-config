{
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "dist",
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext",
		"types": ["node"]
	},
	"include": ["src/**/*", "tests/**/*", "tsdown.config.ts"]
}
