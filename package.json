{
  "name": "@cravingmaker/eslint-config",
  "version": "0.0.10",
  "private": false,
  "description": "Craving Maker's ESLint configuration (Flat Config)",
  "keywords": [
    "cravingmaker",
    "eslint",
    "eslint-config",
    "style",
    "code-style",
    "lint"
  ],
  "homepage": "https://github.com/cravingmaker/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/cravingmaker/eslint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cravingmaker/eslint-config.git"
  },
  "license": "MIT",
  "author": "cravingmaker (https://github.com/cravingmaker)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsdown",
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run build && npm run lint:built",
    "lint:built": "eslint . --max-warnings 0",
    "lint:package": "npm run build && npm run lint:package:built",
    "lint:package:built": "publint --strict",
    "prepare": "husky",
    "prepublishOnly": "npm run release:check",
    "release:check": "npm audit --audit-level=low && npm run validate && npm pack --dry-run --ignore-scripts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:package": "npm run build && npm run typecheck:package:built",
    "typecheck:package:built": "attw --pack . --profile esm-only",
    "validate": "npm run format:check && npm run build && npm run typecheck && npm run lint:built && npm test && npm run lint:package:built && npm run typecheck:package:built"
  },
  "lint-staged": {
    "*.{ts,mts,tsx,js,mjs,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "package.json": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.md": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "prettier": "@cravingmaker/prettier-config",
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/json": "2.1.0",
    "@eslint/markdown": "8.0.3",
    "@html-eslint/eslint-plugin": "0.66.1",
    "@html-eslint/parser": "0.66.1",
    "eslint-enforce-package-type": "1.3.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-package-json": "1.9.0",
    "eslint-plugin-perfectionist": "5.11.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.2.0",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-unicorn": "74.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.12.0",
    "jsonc-eslint-parser": "3.3.0",
    "typescript-eslint": "8.70.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@cravingmaker/prettier-config": "0.1.12",
    "@html-eslint/eslint-plugin-react": "0.66.1",
    "@html-eslint/eslint-plugin-svelte": "0.66.1",
    "@types/eslint-plugin-security": "3.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-plugin-express-security": "3.2.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "publint": "0.3.24",
    "react": "19.3.0",
    "svelte": "5.55.9",
    "svelte-eslint-parser": "1.8.1",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@html-eslint/eslint-plugin-react": ">=0.60.0 <1",
    "@html-eslint/eslint-plugin-svelte": ">=0.60.0 <1",
    "eslint": ">=10.4.0 <11",
    "eslint-plugin-express-security": ">=1.2.0 <4",
    "eslint-plugin-react-hooks": ">=7.1.0 <8",
    "eslint-plugin-react-refresh": ">=0.5.0 <1",
    "react": ">=19.0.0 <20",
    "svelte": ">=5.0.0 <6",
    "svelte-eslint-parser": ">=1.6.0 <2"
  },
  "peerDependenciesMeta": {
    "@html-eslint/eslint-plugin-react": {
      "optional": true
    },
    "@html-eslint/eslint-plugin-svelte": {
      "optional": true
    },
    "eslint-plugin-express-security": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-react-refresh": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "svelte-eslint-parser": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.15.0",
      "onFail": "warn"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
